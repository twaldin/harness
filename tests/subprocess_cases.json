      "options": {"timeoutSeconds": 20, "stdin": {"repeat": "x", "times": 2097152}, "maxOutputBytes": 4194304},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {
        "termination": "exited",
        "exitCode": 0,
        "stdoutEqualsStdin": true,
        "stdoutBytes": 2097152,
        "stdoutTruncated": false,
        "stderrLength": 200000,
        "stderrBytes": 200000,
        "stderrTruncated": false
      }
    },
    {
      "id": "stdin-early-close-is-not-an-error",
