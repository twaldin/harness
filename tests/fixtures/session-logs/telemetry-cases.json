      {"id":"one","type":"gemini","model":"gemini-2.5-pro","tokens":{"input":10,"output":1}},
      {"id":"two","type":"gemini","model":"gemini-2.5-flash","tokens":{"input":20,"output":2}}
    ],
    "expected": {"tokensIn":30,"tokensOut":3,"model":null,"costUsd":null}
  },
