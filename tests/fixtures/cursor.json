{
  "spec": {
    "harness": "cursor",
    "prompt": "Summarize the synthetic repository.",
    "instructions": "Use only the synthetic repository.\n",
    "timeoutSeconds": 30
  },
  "expectedCommand": {
    "cmd": "agent",
    "args": [
      "--print",
      "--output-format",
      "stream-json",
      "--stream-partial-output",
      "--",
      "Summarize the synthetic repository."
    ],
    "cwd": "<workdir>",
    "env": {},
    "instructionsFile": "<workdir>/AGENTS.md",
    "directories": [],
    "model": null,
    "gracefulSignal": "SIGINT"
  },
  "capabilities": {
    "backend": "cli",
    "permissionPolicies": [
      "upstream",
      "bypass"
    ],
    "nativeOptions": null,
    "configHomeEnv": "CURSOR_CONFIG_DIR",
    "configFileFlag": null,
    "streaming": true,
    "cancellation": true,
    "sessions": false
  },
  "sampleOutput": {
    "exitCode": 0,
    "durationSeconds": 2.5,
    "timedOut": false,
    "stdout": "{\"type\":\"system\",\"subtype\":\"init\",\"apiKeySource\":\"env\",\"cwd\":\"/synthetic\",\"session_id\":\"synthetic-session\",\"model\":\"Synthetic Model\",\"permissionMode\":\"default\"}\n{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"One file.\"}]},\"session_id\":\"synthetic-session\",\"timestamp_ms\":100}\n{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"duration_ms\":1234,\"duration_api_ms\":1234,\"result\":\"One file.\",\"session_id\":\"synthetic-session\",\"request_id\":\"synthetic-request\",\"usage\":{\"inputTokens\":100,\"outputTokens\":12,\"cacheReadTokens\":50,\"cacheWriteTokens\":25}}\n",
    "stderr": ""
  },
  "expectedParsed": {
    "costUsd": null,
    "tokensIn": 100,
    "tokensOut": 12,
    "raw": [
      {
        "type": "system",
        "subtype": "init",
        "apiKeySource": "env",
        "cwd": "/synthetic",
        "session_id": "synthetic-session",
        "model": "Synthetic Model",
        "permissionMode": "default"
      },
      {
        "type": "assistant",
        "message": {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "One file."
            }
          ]
        },
        "session_id": "synthetic-session",
        "timestamp_ms": 100
      },
      {
        "type": "result",
        "subtype": "success",
        "is_error": false,
        "duration_ms": 1234,
        "duration_api_ms": 1234,
        "result": "One file.",
        "session_id": "synthetic-session",
        "request_id": "synthetic-request",
        "usage": {
          "inputTokens": 100,
          "outputTokens": 12,
          "cacheReadTokens": 50,
          "cacheWriteTokens": 25
        }
      }
    ]
  },
