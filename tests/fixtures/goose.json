{
  "spec": {
    "harness": "goose",
    "prompt": "Say hello.",
    "instructions": "Be terse.\n",
    "timeoutSeconds": 30
  },
  "expectedCommand": {
    "cmd": "goose",
    "args": [
      "run",
      "--quiet",
      "--output-format",
      "stream-json",
      "--system=Be terse.\n",
      "--text=Say hello."
    ],
    "cwd": "<workdir>",
    "env": {},
    "instructionsFile": null,
    "directories": [],
    "model": null
  },
  "capabilities": {
    "backend": "cli",
    "permissionPolicies": [
      "upstream",
      "bypass"
    ],
    "nativeOptions": null,
    "configHomeEnv": "GOOSE_PATH_ROOT",
    "configFileFlag": null,
    "streaming": true,
    "cancellation": true,
    "sessions": false
  },
  "sampleOutput": {
    "exitCode": 0,
    "durationSeconds": 0.2,
    "timedOut": false,
    "stdout": "goose is ready\n{\"type\":\"message\",\"message\":{\"id\":\"synthetic-message\",\"role\":\"assistant\",\"created\":0,\"content\":[{\"type\":\"text\",\"text\":\"Synthetic answer.\"}],\"metadata\":{\"userVisible\":true,\"agentVisible\":true}}}\n{\"type\":\"notification\",\"extension_id\":\"synthetic\",\"progress\":{\"progress\":1.0,\"total\":2.0,\"message\":\"Scanning\"}}\n{\"type\":\"complete\",\"total_tokens\":27,\"input_tokens\":20,\"output_tokens\":7,\"cache_read_input_tokens\":5,\"cache_write_input_tokens\":2,\"cost_usd\":0.125}\n",
    "stderr": ""
  },
  "expectedParsed": {
    "costUsd": 0.125,
    "tokensIn": 20,
    "tokensOut": 7,
    "raw": [
      {
        "type": "message",
        "message": {
          "id": "synthetic-message",
          "role": "assistant",
          "created": 0,
          "content": [
            {
              "type": "text",
              "text": "Synthetic answer."
            }
          ],
          "metadata": {
            "userVisible": true,
            "agentVisible": true
          }
        }
      },
      {
        "type": "notification",
        "extension_id": "synthetic",
        "progress": {
          "progress": 1.0,
          "total": 2.0,
          "message": "Scanning"
        }
      },
      {
        "type": "complete",
        "total_tokens": 27,
        "input_tokens": 20,
        "output_tokens": 7,
        "cache_read_input_tokens": 5,
        "cache_write_input_tokens": 2,
        "cost_usd": 0.125
      }
    ]
  },
