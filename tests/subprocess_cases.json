      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {
        "termination": "signaled",
        "signal": "SIGTERM",
        "exitCode": -15,
        "timedOut": false,
        "timeoutKind": null,
        "launchError": null,
        "stdout": "tree stdout ✓ 日本語 𝄞\n",
        "stderrContains": "PROCESS_TREE_STDERR_MARKER\n",
        "maxDurationSeconds": 8.5
      }
    },
    {
      "id": "wall-timeout-kills-term-ignoring-tree",
      "category": "timeout",
      "argv": ["{python}", "{tests}/process_tree.py", "tree", "{dir}"],
      "options": {"timeoutSeconds": 1},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {
        "termination": "timed-out",
        "timeoutKind": "wall",
        "timedOut": true,
        "exitCode": -1,
        "launchError": null,
        "minDurationSeconds": 1,
        "maxDurationSeconds": 4,
        "treeStopped": true,
        "stdout": "tree stdout ✓ 日本語 𝄞\n",
        "stderrContains": "PROCESS_TREE_STDERR_MARKER\n"
      }
    },
    {
      "id": "wall-timeout-reaps-direct-child",
      "category": "timeout",
      "argv": ["{python}", "{tests}/process_tree.py", "solo", "{dir}"],
      "options": {"timeoutSeconds": 1},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {"termination": "timed-out", "timeoutKind": "wall", "leaderReaped": true}
    },
    {
      "id": "inactivity-timeout-is-opt-in",
      "category": "timeout",
      "argv": ["sh", "-c", "echo a; sleep 30"],
      "options": {"timeoutSeconds": null, "inactivityTimeoutSeconds": 0.3},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {
        "termination": "timed-out",
        "timeoutKind": "inactivity",
        "timedOut": true,
        "exitCode": -1,
        "stdout": "a\n",
        "minDurationSeconds": 0.3,
        "maxDurationSeconds": 3.3
      }
    },
    {
      "id": "silence-alone-is-not-failure",
      "category": "timeout",
      "argv": ["sh", "-c", "sleep 0.5; echo late"],
      "options": {"timeoutSeconds": null},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {"termination": "exited", "exitCode": 0, "timeoutKind": null, "timedOut": false, "stdout": "late\n"}
    },
    {
      "id": "inactivity-resets-on-either-stream",
      "category": "timeout",
      "argv": ["{python}", "{tests}/subprocess_child.py", "stderr-ticks", "6", "0.1"],
      "options": {"timeoutSeconds": null, "inactivityTimeoutSeconds": 0.3},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {"termination": "exited", "exitCode": 0, "stdout": "done\n", "stderr": "......"}
    },
    {
      "id": "inactivity-counts-from-launch",
      "category": "timeout",
      "argv": ["sleep", "5"],
      "options": {"timeoutSeconds": null, "inactivityTimeoutSeconds": 0.3},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {"termination": "timed-out", "timeoutKind": "inactivity", "timedOut": true, "stdout": "", "stdoutBytes": 0, "minDurationSeconds": 0.3, "maxDurationSeconds": 3.3}
    },
    {
      "id": "wall-timeout-wins-over-later-inactivity",
      "category": "timeout",
      "argv": ["sh", "-c", "sleep 30"],
      "options": {"timeoutSeconds": 0.2, "inactivityTimeoutSeconds": 10},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {"termination": "timed-out", "timeoutKind": "wall", "timedOut": true, "exitCode": -1, "maxDurationSeconds": 3.2}
    },
    {
      "id": "cancel-after-ready-stops-tree",
      "category": "cancellation",
      "argv": ["{python}", "{tests}/process_tree.py", "tree", "{dir}"],
      "options": {"timeoutSeconds": 20},
      "cancel": "afterReady",
      "runners": {"python": ["sync", "async"], "typescript": ["async"]},
      "note": "TypeScript runSubprocess blocks its caller, so an abort raised after launch cannot be delivered; only the async entry point honors in-flight cancellation.",
      "expect": {
        "termination": "cancelled",
        "exitCode": -1,
        "timedOut": false,
        "timeoutKind": null,
        "launchError": null,
        "treeStopped": true,
        "stdout": "tree stdout ✓ 日本語 𝄞\n",
        "stderrContains": "PROCESS_TREE_STDERR_MARKER\n",
        "maxCancelLatencySeconds": 3,
        "maxDurationSeconds": 5
      }
    },
    {
      "id": "cancel-before-launch-spawns-nothing",
      "category": "cancellation",
      "argv": ["sh", "-c", "touch launched; sleep 5"],
      "options": {"timeoutSeconds": 5},
      "cancel": "beforeLaunch",
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {
        "termination": "cancelled",
        "exitCode": -1,
        "timedOut": false,
        "stdout": "",
        "maxDurationSeconds": 1,
        "filesAbsent": ["launched"]
      }
    },
    {
      "id": "cancel-delivers-sigterm-to-graceful-tree",
      "category": "cancellation",
      "argv": ["{python}", "{tests}/process_tree.py", "graceful", "{dir}"],
      "options": {"timeoutSeconds": 20},
      "cancel": "afterReady",
      "runners": {"python": ["sync", "async"], "typescript": ["async"]},
      "note": "Same sync restriction as cancel-after-ready-stops-tree.",
      "expect": {
        "termination": "cancelled",
        "exitCode": -1,
        "timedOut": false,
        "treeStopped": true,
        "filesExist": ["leader.term", "child.term", "grandchild.term"],
        "maxCancelLatencySeconds": 3
      }
    },
    {
      "id": "cancel-delivers-selected-sigint-to-interrupt-tree",
      "category": "cancellation",
      "argv": ["{python}", "{tests}/process_tree.py", "interrupt", "{dir}"],
      "options": {"timeoutSeconds": 20, "gracefulSignal": "SIGINT"},
      "cancel": "afterReady",
      "runners": {"python": ["sync", "async"], "typescript": ["async"]},
      "note": "The leader ignores SIGTERM and stops only on SIGINT, forwarding it to a child it started in its own session (outside the runner's group) and reaping it before exiting 0. Same sync restriction as cancel-after-ready-stops-tree.",
      "expect": {
        "termination": "cancelled",
        "exitCode": -1,
        "timedOut": false,
        "timeoutKind": null,
        "signal": null,
        "launchError": null,
        "leaderReaped": true,
        "childRunning": false,
        "filesExist": ["leader.int", "child.int"],
        "stdout": "tree stdout ✓ 日本語 𝄞\n",
        "stderrContains": "PROCESS_TREE_STDERR_MARKER\n",
        "maxCancelLatencySeconds": 3
      }
    },
    {
      "id": "cancel-with-default-sigterm-force-kills-interrupt-tree",
      "category": "cancellation",
      "argv": ["{python}", "{tests}/process_tree.py", "interrupt", "{dir}"],
      "options": {"timeoutSeconds": 20},
      "cancel": "afterReady",
      "runners": {"python": ["sync", "async"], "typescript": ["async"]},
      "note": "Same tree without selecting SIGINT: the default SIGTERM is ignored, the leader is SIGKILLed after the grace period without ever writing leader.int, and the detached child (not ours to stop) keeps running. The tester owns it through child.pid.",
      "expect": {
        "termination": "cancelled",
        "exitCode": -1,
        "timedOut": false,
        "signal": "SIGKILL",
        "leaderReaped": true,
        "childRunning": true,
        "filesAbsent": ["leader.int", "child.int"],
        "maxCancelLatencySeconds": 3
      }
    },
