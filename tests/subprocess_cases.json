    {
      "id": "zero-cap-with-silent-child-is-not-truncated",
      "category": "flood",
      "argv": ["true"],
      "options": {"timeoutSeconds": 5, "maxOutputBytes": 0},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {
        "termination": "exited",
        "exitCode": 0,
        "stdoutBytes": 0,
        "stderrBytes": 0,
        "stdoutTruncated": false,
