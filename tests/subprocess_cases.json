      "argv": ["sh", "-c", "cat; echo eof"],
      "options": {"timeoutSeconds": 5, "stdin": ""},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {"termination": "exited", "exitCode": 0, "stdout": "eof\n"}
    },
    {
      "id": "stdin-utf8-round-trips-then-eof",
      "category": "stdinEof",
      "argv": ["sh", "-c", "cat; echo eof"],
      "options": {"timeoutSeconds": 5, "stdin": "café ✓ 𝄞\n"},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {"termination": "exited", "exitCode": 0, "stdout": "café ✓ 𝄞\neof\n", "stdoutBytes": 19}
    },
    {
