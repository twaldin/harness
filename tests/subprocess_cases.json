    {
      "id": "split-utf8-across-reads-stays-whole",
      "category": "chunkBoundary",
      "argv": ["{python}", "{tests}/subprocess_child.py", "gated-pieces", "{dir}", "68c3", "a96c6c6f20e2", "9c930a"],
      "options": {"timeoutSeconds": 10, "onOutput": true},
      "acknowledgeChunks": true,
      "runners": {"python": ["sync", "async"], "typescript": ["async"]},
      "note": "Each decoded callback acknowledges a piece before the child writes the next, forcing UTF-8 splits across reads. TypeScript sync cannot provide callbacks.",
      "expect": {
        "termination": "exited",
        "stdout": "héllo ✓\n",
        "streamedStdout": "héllo ✓\n",
        "streamedNoReplacement": true,
        "stdoutBytes": 11,
        "stdoutTruncated": false
      }
    },
    {
      "id": "split-utf8-across-reads-captures-whole",
      "category": "chunkBoundary",
      "argv": ["{python}", "{tests}/subprocess_child.py", "write-pieces", "68c3", "a96c6c6f20e2", "9c930a"],
      "options": {"timeoutSeconds": 10},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {"termination": "exited", "stdout": "héllo ✓\n", "stdoutBytes": 11, "stdoutTruncated": false}
    },
    {
      "id": "cap-inside-multibyte-drops-partial-code-point",
