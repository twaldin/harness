      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {
        "termination": "exited",
        "exitCode": 3,
        "launchError": null,
        "stdout": "yyyyyyyyyy",
        "maxDurationSeconds": 3
      }
    },
    {
      "id": "self-sigterm-is-signaled-not-timed-out",
