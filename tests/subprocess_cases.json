      "runners": {"python": ["sync", "async"], "typescript": ["async"]},
      "note": "TypeScript runSubprocess rejects onOutput before launch; Python's blocking runner accepts synchronous callbacks.",
      "expect": {
        "termination": "exited",
        "callbackError": null,
        "stdout": "",
        "stderr": "",
        "stdoutTruncated": true,
