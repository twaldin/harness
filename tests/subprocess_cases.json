    },
    {
      "id": "escaped-pipe-holder-does-not-hang-the-run",
      "category": "grandchildren",
      "argv": ["{python}", "{tests}/process_tree.py", "escaped", "{dir}"],
      "options": {"timeoutSeconds": 30},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "note": "Documented limitation: a descendant that left the process group is not ours to stop; it stays running.",
      "expect": {
        "termination": "exited",
        "exitCode": 0,
        "timedOut": false,
        "stdout": "tree stdout ✓ 日本語 𝄞\n",
        "leaderReaped": true,
