{
  "spec": {
    "harness": "omp",
    "prompt": "Say hello.",
    "model": "sonnet",
    "instructions": "Be terse.\n",
    "timeoutSeconds": 30
  },
  "expectedCommand": {
    "cmd": "omp",
    "args": [
      "--print",
      "--mode",
      "json",
      "--no-session",
      "--model",
      "sonnet",
      "--",
      "Say hello."
    ],
    "cwd": "<workdir>",
    "env": {},
    "instructionsFile": "<workdir>/AGENTS.md",
    "directories": [],
    "model": "sonnet"
  },
  "capabilities": {
    "backend": "cli",
    "permissionPolicies": [
      "upstream",
      "bypass"
    ],
    "nativeOptions": null,
    "configHomeEnv": "PI_CODING_AGENT_DIR",
    "configFileFlag": "--config",
    "streaming": true,
    "cancellation": true,
    "sessions": false
  },
  "sampleOutput": {
    "exitCode": 0,
    "durationSeconds": 0.2,
    "timedOut": false,
    "stdout": "{\"type\":\"session\",\"id\":\"synthetic-omp-session\",\"version\":3,\"cwd\":\"<workdir>\"}\n{\"type\":\"agent_start\"}\n{\"type\":\"message_update\",\"assistantMessageEvent\":{\"type\":\"text_delta\",\"delta\":\"Synthetic answer.\"}}\n{\"type\":\"message_end\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Synthetic answer.\"}],\"usage\":{\"input\":12,\"output\":3,\"cacheRead\":7,\"cacheWrite\":2,\"cost\":{\"total\":0.125}},\"stopReason\":\"stop\"}}\n{\"type\":\"turn_end\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Synthetic answer.\"}],\"usage\":{\"input\":12,\"output\":3,\"cacheRead\":7,\"cacheWrite\":2,\"cost\":{\"total\":0.125}},\"stopReason\":\"stop\"},\"toolResults\":[]}\n{\"type\":\"agent_end\",\"messages\":[{\"role\":\"user\",\"content\":\"Say hello.\"},{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Synthetic answer.\"}],\"usage\":{\"input\":12,\"output\":3,\"cacheRead\":7,\"cacheWrite\":2,\"cost\":{\"total\":0.125}},\"stopReason\":\"stop\"}]}\n",
    "stderr": ""
  },
  "expectedParsed": {
    "costUsd": 0.125,
    "tokensIn": 12,
    "tokensOut": 3,
    "raw": [
      {
        "type": "session",
        "id": "synthetic-omp-session",
        "version": 3,
        "cwd": "<workdir>"
      },
      {
        "type": "agent_start"
      },
      {
        "type": "message_update",
        "assistantMessageEvent": {
          "type": "text_delta",
          "delta": "Synthetic answer."
        }
      },
      {
        "type": "message_end",
        "message": {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "Synthetic answer."
            }
          ],
          "usage": {
            "input": 12,
            "output": 3,
            "cacheRead": 7,
            "cacheWrite": 2,
            "cost": {
              "total": 0.125
            }
          },
          "stopReason": "stop"
        }
      },
      {
        "type": "turn_end",
        "message": {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "Synthetic answer."
            }
          ],
          "usage": {
            "input": 12,
            "output": 3,
            "cacheRead": 7,
            "cacheWrite": 2,
            "cost": {
              "total": 0.125
            }
          },
          "stopReason": "stop"
        },
        "toolResults": []
      },
      {
        "type": "agent_end",
        "messages": [
          {
            "role": "user",
            "content": "Say hello."
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Synthetic answer."
              }
            ],
            "usage": {
              "input": 12,
              "output": 3,
              "cacheRead": 7,
              "cacheWrite": 2,
              "cost": {
                "total": 0.125
              }
            },
            "stopReason": "stop"
          }
        ]
      }
    ]
  },
