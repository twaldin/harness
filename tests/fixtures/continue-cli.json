{
  "spec": {
    "harness": "continue-cli",
    "prompt": "add docstrings to all public functions",
    "model": "anthropic/claude-sonnet-4-6",
    "instructions": "Keep it brief.\n",
    "timeoutSeconds": 600
  },
  "expectedCommand": {
    "cmd": "cn",
    "args": [
      "-p",
      "add docstrings to all public functions",
      "--model",
      "anthropic/claude-sonnet-4-6",
      "--rule",
      "<workdir>/CONTINUE.md",
      "--format",
      "json"
    ],
    "cwd": "<workdir>",
    "env": {},
    "instructionsFile": "<workdir>/CONTINUE.md",
    "directories": [],
    "model": "anthropic/claude-sonnet-4-6"
  },
  "capabilities": {
    "backend": "cli",
    "permissionPolicies": [
      "upstream",
      "bypass"
    ],
    "nativeOptions": null,
    "configHomeEnv": null,
    "configFileFlag": "--config",
    "streaming": true,
    "cancellation": true,
    "sessions": false
  },
  "sampleOutput": {
    "exitCode": 0,
    "durationSeconds": 7.1,
    "timedOut": false,
    "stdout": "{\"response\":\"added docstrings\",\"status\":\"success\",\"note\":\"Response was not valid JSON, so it was wrapped in a JSON object\"}\n",
    "stderr": ""
  },
  "expectedParsed": {
    "costUsd": null,
    "tokensIn": null,
    "tokensOut": null,
    "raw": {
      "response": "added docstrings",
      "status": "success",
      "note": "Response was not valid JSON, so it was wrapped in a JSON object"
    }
  },
  "cases": [
    {
      "name": "caller-config-rejects-explicit-Hub-model",
      "spec": {
        "configFile": "<root>/continue.yaml"
      },
      "expectedError": "unsupported-capability"
    },
    {
      "name": "default-model-delegates-to-upstream-config",
      "spec": {
        "model": ""
      },
      "expectedCommand": {
        "cmd": "cn",
        "args": [
          "-p",
          "add docstrings to all public functions",
          "--rule",
          "<workdir>/CONTINUE.md",
          "--format",
          "json"
        ],
        "cwd": "<workdir>",
        "env": {},
        "instructionsFile": "<workdir>/CONTINUE.md",
        "directories": [],
        "model": null
      }
    },
    {
      "name": "bypass-maps-to-auto",
      "spec": {
        "permissionPolicy": "bypass"
      },
      "expectedCommand": {
        "cmd": "cn",
        "args": [
          "-p",
          "add docstrings to all public functions",
          "--auto",
          "--model",
          "anthropic/claude-sonnet-4-6",
          "--rule",
          "<workdir>/CONTINUE.md",
          "--format",
          "json"
        ],
        "cwd": "<workdir>",
        "env": {},
        "instructionsFile": "<workdir>/CONTINUE.md",
        "directories": [],
        "model": "anthropic/claude-sonnet-4-6"
      }
    },
    {
      "name": "bare-native-model-is-not-a-hub-slug",
      "spec": {
        "model": "claude-sonnet-4-6"
      },
      "expectedError": "unsupported-capability"
    },
    {
      "name": "model-text-usage-fields-are-not-telemetry",
      "sampleOutput": {
        "exitCode": 0,
        "durationSeconds": 9.4,
        "timedOut": false,
        "stdout": "{\"status\":\"info\",\"message\":\"Auto-compacting triggered\",\"contextUsage\":\"91%\"}\n{\"status\":\"success\",\"message\":\"Auto-compacted successfully\"}\n{\"type\":\"result\",\"result\":\"added docstrings\",\"usage\":{\"input_tokens\":950,\"output_tokens\":380},\"total_cost_usd\":0.0187}\n",
        "stderr": ""
      },
      "expectedParsed": {
        "costUsd": null,
        "tokensIn": null,
        "tokensOut": null,
        "raw": {
          "type": "result",
          "result": "added docstrings",
          "usage": {
            "input_tokens": 950,
            "output_tokens": 380
          },
          "total_cost_usd": 0.0187
        }
      }
    },
    {
      "name": "config-file-rejects-whitespace-model",
      "spec": {
        "model": "   ",
        "configFile": "<root>/continue.yaml"
      },
      "expectedError": "unsupported-capability"
    },
    {
      "name": "config-file-owns-model-selection",
      "spec": {
        "model": "",
        "configFile": "<root>/continue.yaml"
      },
      "expectedCommand": {
        "cmd": "cn",
        "args": [
          "-p",
          "--config",
          "<root>/continue.yaml",
          "--rule",
          "<workdir>/CONTINUE.md",
          "--format",
          "json",
          "add docstrings to all public functions"
        ],
        "cwd": "<workdir>",
        "env": {},
        "instructionsFile": "<workdir>/CONTINUE.md",
        "directories": [],
        "model": null
      }
    }
  ]
}
