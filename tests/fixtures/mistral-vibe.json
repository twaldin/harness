            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "One source file."
              }
            ],
            "source": "harness",
            "userDisplayContent": null
          }
        ]
      }
    },
    {
      "name": "noise-and-nonobjects-ignored",
      "sampleOutput": {
        "exitCode": 0,
        "durationSeconds": 0.1,
        "timedOut": false,
        "stdout": "null\n[]\n3\n{\"bad\":NaN}\nnot json\n{\"id\": \"synthetic-entry\", \"sessionId\": \"synthetic-session\", \"turnId\": \"synthetic-turn\", \"createdAt\": 1, \"updatedAt\": 2, \"generationStatus\": \"completed\", \"relatedEntryId\": null, \"type\": \"message\", \"role\": \"assistant\", \"content\": [{\"type\": \"text\", \"text\": \"One source file.\"}], \"source\": \"harness\", \"userDisplayContent\": null}",
        "stderr": ""
