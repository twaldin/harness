    {
      "id": "invalid-utf8-capture-uses-replacement",
      "category": "chunkBoundary",
      "argv": ["{python}", "{tests}/subprocess_child.py", "write-pieces", "6f6bff", "e29c"],
      "options": {"timeoutSeconds": 10},
      "runners": {"python": ["sync", "async"], "typescript": ["sync", "async"]},
      "expect": {"termination": "exited", "stdout": "ok\ufffd\ufffd", "stdoutBytes": 5, "stdoutTruncated": false}
    },
    {
      "id": "incomplete-utf8-at-forced-close-uses-replacement",
      "category": "chunkBoundary",
