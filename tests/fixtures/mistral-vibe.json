            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "One source file."
              }
            ],
            "source": "harness",
            "userDisplayContent": null
          }
        ]
      }
    },
    {
      "name": "unknown-object-preserved-without-invented-telemetry",
      "sampleOutput": {
        "exitCode": 0,
        "durationSeconds": 0.1,
        "timedOut": false,
        "stdout": "{\"type\":\"future\",\"tokens\":50,\"cost\":1}\n",
        "stderr": ""
      },
      "expectedParsed": {
        "costUsd": null,
        "tokensIn": null,
        "tokensOut": null,
        "raw": [
          {
            "type": "future",
            "tokens": 50,
            "cost": 1
          }
        ]
      }
