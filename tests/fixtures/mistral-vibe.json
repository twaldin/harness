{
  "spec": {
    "harness": "mistral-vibe",
    "prompt": "Summarize the synthetic repository.",
    "instructions": "Use only the synthetic repository.\n",
    "nativeOptions": {
      "kind": "mistral-vibe",
      "trust": true
    },
    "timeoutSeconds": 30
  },
  "expectedCommand": {
    "cmd": "vibe",
    "args": [
      "--output",
      "streaming",
      "--trust",
      "--prompt=Summarize the synthetic repository."
    ],
    "cwd": "<workdir>",
    "env": {},
    "instructionsFile": "<workdir>/AGENTS.md",
    "directories": [],
    "model": null
  },
  "capabilities": {
    "backend": "cli",
    "permissionPolicies": [
      "upstream",
      "bypass"
    ],
    "nativeOptions": "mistral-vibe",
    "configHomeEnv": "VIBE_HOME",
    "configFileFlag": null,
    "streaming": true,
    "cancellation": true,
    "sessions": false
  },
  "sampleOutput": {
    "exitCode": 0,
    "durationSeconds": 0.1,
    "timedOut": false,
    "stdout": "{\"id\": \"synthetic-entry\", \"sessionId\": \"synthetic-session\", \"turnId\": \"synthetic-turn\", \"createdAt\": 1, \"updatedAt\": 2, \"generationStatus\": \"completed\", \"relatedEntryId\": null, \"type\": \"message\", \"role\": \"assistant\", \"content\": [{\"type\": \"text\", \"text\": \"One source file.\"}], \"source\": \"harness\", \"userDisplayContent\": null}\n",
    "stderr": ""
  },
  "expectedParsed": {
    "costUsd": null,
    "tokensIn": null,
    "tokensOut": null,
    "raw": [
      {
        "id": "synthetic-entry",
        "sessionId": "synthetic-session",
        "turnId": "synthetic-turn",
        "createdAt": 1,
        "updatedAt": 2,
        "generationStatus": "completed",
        "relatedEntryId": null,
        "type": "message",
        "role": "assistant",
        "content": [
          {
            "type": "text",
            "text": "One source file."
          }
        ],
        "source": "harness",
        "userDisplayContent": null
      }
    ]
  },
  "cases": [
    {
      "name": "native-auth-failure",
      "sampleOutput": {
        "exitCode": 1,
        "durationSeconds": 0.1,
        "timedOut": false,
        "stdout": "",
        "stderr": "Error: Missing API key for synthetic provider.\n"
      },
      "expectedParsed": {
        "costUsd": null,
        "tokensIn": null,
        "tokensOut": null,
        "raw": null
      }
    },
    {
      "name": "partial-stream-retains-completed-history",
      "sampleOutput": {
        "exitCode": 1,
        "durationSeconds": 0.1,
        "timedOut": false,
        "stdout": "{\"id\": \"synthetic-entry\", \"sessionId\": \"synthetic-session\", \"turnId\": \"synthetic-turn\", \"createdAt\": 1, \"updatedAt\": 2, \"generationStatus\": \"completed\", \"relatedEntryId\": null, \"type\": \"message\", \"role\": \"assistant\", \"content\": [{\"type\": \"text\", \"text\": \"One source file.\"}], \"source\": \"harness\", \"userDisplayContent\": null}\n{\"id\":",
        "stderr": ""
      },
      "expectedParsed": {
        "costUsd": null,
        "tokensIn": null,
        "tokensOut": null,
        "raw": [
          {
            "id": "synthetic-entry",
            "sessionId": "synthetic-session",
            "turnId": "synthetic-turn",
            "createdAt": 1,
            "updatedAt": 2,
